<odoo>
    <record id="view_order_form_inherit_custom_delivery_address" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.delivery.address</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Tree view (inside order_line One2many) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="custom_partner_id"/>
            </xpath>

<!--            &lt;!&ndash; Form view (popup per line) &ndash;&gt;-->
<!--            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">-->
<!--                <field name="custom_partner_id"/>-->
<!--            </xpath>-->

        </field>
    </record>
</odoo>
