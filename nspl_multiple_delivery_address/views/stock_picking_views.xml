<odoo>
    <record id="stock_picking_form_view_inherit_custom_address" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.delivery.address</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="custom_partner_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_custom" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="custom_partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
